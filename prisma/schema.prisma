// Prisma schema — Celebration Planner cloud layer (Phase 3 / GAP 2).
//
// Design: relational identity + ownership (User/Session/SyncedEvent) with a
// validated JSON snapshot per event. The event aggregate spans 15+ nested
// collections (guests, tasks, vendors+quotes, expenses, gifts, mood tiles,
// seating, payments, run sheet, invitations, agent runs) — a document
// snapshot keyed by (userId, localId) preserves exact fidelity without a
// 16-model mapping layer, while public RSVP responses get their own table
// so concurrent guest submissions can never clobber each other.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  passwordHash String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     Session[]
  events       SyncedEvent[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model SyncedEvent {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  localId    String
  title      String
  eventType  String
  eventDate  String?
  snapshot   String
  version    Int            @default(1)
  rsvpToken  String?        @unique
  albumToken String?        @unique
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  responses  RsvpResponse[]
  photos     GuestPhoto[]

  @@unique([userId, localId])
  @@index([userId])
}

model RsvpResponse {
  id         String      @id @default(cuid())
  eventId    String
  event      SyncedEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestKey   String
  name       String
  attending  String
  plusOnes   Int         @default(0)
  meal       String?
  note       String?
  isNewGuest Boolean     @default(false)
  submittedAt DateTime   @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([eventId, guestKey])
  @@index([eventId])
}

// Guest-shared photos (GAP 3): guests upload through the public /album/[token]
// portal; the host imports them into the on-device memory wall and acks
// (deletes) the server copies — same collect-and-clear flow as RSVP responses.
model GuestPhoto {
  id        String      @id @default(cuid())
  eventId   String
  event     SyncedEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploader  String
  caption   String?
  dataUrl   String
  imported  Boolean     @default(false)
  createdAt DateTime    @default(now())

  @@index([eventId])
}
